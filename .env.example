# Skopiuj do .env (ten plik nie jest wczytywany sam) i wypełnij realnymi
# wartościami. NIE commituj .env - zawiera sekrety (hasło do bazy, Keycloak
# client_secret). Zob. docker-compose.yml.

# ---------------------------------------------------------------------------
# Porty publikowane na hoście
# ---------------------------------------------------------------------------
HUB_PORT=8000
DASHBOARD_PORT=8080
ARENA_PORT=8081

# ---------------------------------------------------------------------------
# Rejestr npm code.galicea.org (pakiet @galicea/nextjs-keycloak-auth) -
# WYMAGA autoryzacji (sprawdzone: 401 bez tokenu). Ten sam token co w
# ~/.npmrc na maszynie deweloperskiej. Patrz secrets/npmrc(.example).
# ---------------------------------------------------------------------------
NPM_TOKEN=

# ---------------------------------------------------------------------------
# Baza danych - PostgreSQL -  NIE jest
# częścią tego docker-compose - łączymy się do istniejącej instancji.
# connection_string() w config/config.py honoruje DATABASE_URL w całości.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://galwork_user:xxxxxxxx@yyyyyy:5432/galwork?sslmode=require
#                 postgresql+psycopg2://<user>:<password>@<host>:<port>/galwork?sslmode=require

# ---------------------------------------------------------------------------
# Keycloak (realm  ten sam co w dev/arenie).
# Nazwy zmiennych = <SEKCJA>_<KLUCZ> z config.ini (config/config.py::
# _section_values) - nadpisują wartości z config.ini.example z obrazu galwork-hub.
# ---------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM_NAME=galwork
KEYCLOAK_CLIENT_ID=galwork
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CERTS_URL=https://keycloak.example.co/realms/galwork/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_GROUPS=wf-admin,galwork-admin

# ---------------------------------------------------------------------------
# galwork-hub - [app]
# ---------------------------------------------------------------------------
# Adres, pod którym stoi dashboard (używany np. w linkach w mailach/EDR).
APP_FRONTEND_URL=https://dashboard.example.pl
APP_DOCS_URL=https://dashboard.example.pl/v1/docs

# Originy, z których wolno wołać API cross-origin - adresy dashboard i arena.
# Jeśli oba frontendy proxują /v1/ przez swoje nginx (patrz HUB_UPSTREAM),
# wywołania są same-origin i CORS praktycznie nie wchodzi w grę - ta lista
# i tak powinna zawierać realne domeny produkcyjne na wszelki wypadek.
APP_CORS_ORIGINS=https://dashboard.example.pl,https://arena.example.pl
APP_CORS_ALLOW_CREDENTIALS=true

# FastAPI debug=True ujawnia tracebacki w odpowiedziach - na produkcji false.
APP_DEBUG=false

# ---------------------------------------------------------------------------
# galwork-dashboard / galwork-arena - zmienne wklejane na trwałe w czasie
# `next build` (output: 'export') - zob. src/configs/config.ts w obu repo.
# Puste NEXT_PUBLIC_API_URL = wywołania względne '/v1/wf', proxowane przez
# nginx tego kontenera do galwork-hub (zalecane w produkcji).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_KEYCLOAK_URL=https://keycloak.example.co/realms/galwork
NEXT_PUBLIC_KEYCLOAK_CLIENT=

# Adres serwera plików edytorów BPMN/formularzy (serwis bpmn-files).
# .bpmn-files = ta sama domena co arena; nginx hosta
# (galwork_arena.conf) proxuje tę ścieżkę do 127.0.0.1:${BPMN_FILES_PORT}
# z hasłem (serwer plików nie ma własnej autoryzacji). Wymagane przez
# build_arena.sh - puste NIE wyłącza edytorów (404 na /api/bpmn/...).

NEXT_PUBLIC_BPMN_FILES_URL=/bpmn-files

# ---------------------------------------------------------------------------
# Wewnętrzny adres galwork-hub w sieci docker-compose (nazwa serwisu "hub").
# Podstawiany w nginx przez wbudowany entrypoint obrazu nginx:*-alpine
# (envsubst na /etc/nginx/templates/*.template przy starcie kontenera).
# ---------------------------------------------------------------------------
HUB_UPSTREAM=http://hub:8000

# ---------------------------------------------------------------------------
# wspólny katalog definicji obiegów (BPMN + formularze) dla
# galwork-hub (odczyt) i serwisu bpmn-files (edycja z areny). Na serwerze
# np. /srv/galwork/spiffworkflow, lokalnie ../galwork-hub/spiffworkflow (względem galwork/).
# Pliki muszą należeć do GALWORK_UID:GALWORK_GID (użytkownik galwork w
# obrazie huba ma uid 1000).
# ---------------------------------------------------------------------------
SPIFFWORKFLOW_DIR=/srv/galwork/spiffworkflow
GALWORK_UID=1000
GALWORK_GID=1000
BPMN_FILES_PORT=8090
# Skrypt serwera plików - z repozytorium galwork-arena (server/bpmn-files.mjs).
BPMN_FILES_SCRIPT=../galwork-arena/server/bpmn-files.mjs
