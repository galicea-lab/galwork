# 2026-11-25: wzór .env huba dla instancji galicea (na podstawie wdrożenia; sekrety usunięte).
# Skopiuj do .env (poza repozytorium, prawa 0600). Ansible (ansible/deploy.yml) wysyła go na serwer.
# ---------------------------------------------------------------------------
# Porty publikowane na hoście (nginx: galwork.galicea.org -> 8060, arena.galicea.org -> 8061)
# ---------------------------------------------------------------------------
HUB_PORT=8060
ARENA_PORT=8061
# modele procesów (BPMN, formularze, druki) - katalog na serwerze, montowany tylko do odczytu
SPIFFWORKFLOW_DIR=/srv/galicea/spiffworkflow

# Frappe Education / ERPNext (galicea.transmem.pl) - konto techniczne z kluczem API
FRAPPE_EDUCATION_BASE_URL=https://galicea.transmem.pl/
FRAPPE_EDUCATION_API_KEY=<klucz API>
FRAPPE_EDUCATION_API_SECRET=<sekret API>
FRAPPE_EDUCATION_TIMEOUT=30

# dane organizacji na wydrukach
PRINT_ORGANIZATION=Cyfrowa Akademia
PRINT_SHORT_NAME=CA
PRINT_CITY=Jarosław
PRINT_CITY_LOCATIVE=Jarosławiu
PRINT_ADDRESS=<adres>
PRINT_LOGO=/app/spiffworkflow/wspolne/druki/logo.png

# baza huba - osobna baza i użytkownik dla instancji (zob. 05baza/README.md)
DATABASE_URL=postgresql+psycopg://galicea_user:<HASLO>@<host-bazy>:25060/galicea?sslmode=require

# Keycloak - weryfikacja tokenów frontów (klient publiczny galwork, zob. 01keycloak/UWAGI.md)
KEYCLOAK_SERVER_URL=https://login.galicea.org
KEYCLOAK_REALM_NAME=galicea
KEYCLOAK_CLIENT_ID=galwork
KEYCLOAK_CERTS_URL=https://login.galicea.org/realms/galicea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=
KEYCLOAK_ADMIN_GROUPS=galwork-admin

# hub
APP_CORS_ALLOW_CREDENTIALS=false
APP_DEBUG=false
APP_CORS_ORIGINS=https://centrum.galicea.org,https://akademia.galicea.org,https://arena.galicea.org,https://pm.galicea.org
HUB_UPSTREAM=http://hub:8000
APP_FRONTEND_URL=https://centrum.galicea.org
APP_DOCS_URL=https://centrum.galicea.org/v1/docs

# e-Doręczenia (pliki PEM w secrets/hub/edr/, prawa 0400)
EDR_ADDRESS=AE:PL-00000-00000-XXXXX-00
EDR_KEY=secret/edr/edr_key.pem
EDR_CERT=secret/edr/edr_cert.pem
EDR_SYSTEM_NAME=GALWORK
EDR_APPLICATION_NAME=GALWORK

# 2026-11-25: pieczęć elektroniczna (galwork-seal) - włączenie po wdrożeniu usługi.
# Wymaga też zamontowania hasła huba do Valkey (zob. komentarz w docker-compose.yml).
# SEAL_ENABLED=true
# SEAL_HOST=seal-valkey
# SEAL_USERNAME=hub
# SEAL_PASSWORD_FILE=/app/secret/seal/valkey_hub_password
# SEAL_KEYID=pieczec
# SEAL_MODELS=edu-pismo
# SEAL_SOURCE=edu-pismo
# SEAL_SUBFILTER=ETSI.CAdES.detached
# SEAL_TSPURL=

# 2026-11-25: integracja Taiga (w realizacji, zob. 09taiga/WDROZENIE.md)
# TAIGA_PASSWORD=<hasło konta technicznego Taigi>

# 2026-11-25: uprawnienia (TODO_bezpieczenstwo 2.2-2.3). Grupy z realmu galicea
# (01keycloak/groups.txt). Student i kandydaci NIE są pracownikami.
WF_STAFF_GROUPS=wf-admin,galwork-admin,act_editor,dziekanat,iod,it,wykladowca,kancelaria
# skrzynka i wyszukiwarka e-Doręczeń - grupa kancelaria do założenia w Keycloak
EDR_OPERATOR_GROUPS=kancelaria,edr-system
# pełne dane kontrahentów (PESEL, adresy); pusto = tylko administratorzy
WF_CONTACT_GROUPS=kancelaria
# zadania bez przypisania: restricted (domyślnie) | open
WF_UNASSIGNED_TASKS=restricted
# archiwum Paperless; pusto = każdy pracownik
PAPERLESS_READER_GROUPS=
