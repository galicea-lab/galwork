# AI 2026-11-25: zmienne .env huba (docker compose) dla integracji Taiga - galwork-pm - ERPNext.
# Hub w obrazie ma config.ini z config.ini.example; każdą wartość nadpisuje zmienna <SEKCJA>_<KLUCZ>
# (connector/base.py). Bez Dockera te same wartości wpisuje się w sekcje [taiga] i [erpnext] config.ini.
TAIGA_BASE_URL=https://taiga.galicea.org
TAIGA_USERNAME=galwork
TAIGA_PASSWORD=<hasło konta technicznego Taigi>
# liczbowe id konta technicznego w Taidze (nie login) - jego zmiany są ignorowane
TAIGA_TECHNICAL_USER_ID=9
# puste = bez webhooka; zmiany zbiera rekoncyliacja z timeline'u projektu
TAIGA_WEBHOOK_URL=
TAIGA_ACTIVITY_TYPES=programowanie,dokumentowanie,testowanie,wdrażanie
# zapis Timesheetów do ERPNext - włączyć dopiero po erp-check i erp-sync --dry-run
TAIGA_ERP_SYNC=false
TAIGA_PM_URL=https://pm.galicea.org

# konto techniczne galwork-hub@galicea.org w ERPNext, jedyna rola "Galwork Integracja"
ERPNEXT_BASE_URL=https://galicea.transmem.pl
ERPNEXT_API_KEY=<klucz API>
ERPNEXT_API_SECRET=<sekret API>
