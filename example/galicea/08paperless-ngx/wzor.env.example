# 2026-11-25: wzór .env Paperless-ngx (sekrety usunięte) - skopiuj do .env obok docker-compose.yml
# ==== Baza danych (zewnętrzny PostgreSQL) ====
PAPERLESS_DBHOST=<host-bazy>
PAPERLESS_DBPORT=25060
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=<HASLO>
PAPERLESS_DBSSLMODE=require

# ==== Redis (broker) ====
PAPERLESS_REDIS=redis://broker:6379

# ==== Aplikacja ====
PAPERLESS_SECRET_KEY=<losowy ciąg, np. openssl rand -base64 48>
PAPERLESS_URL=https://docs.transmem.pl
PAPERLESS_TIME_ZONE=Europe/Warsaw

# ==== Keycloak (OIDC, klient poufny) ====
KEYCLOAK_URL=https://login.galicea.org
KEYCLOAK_REALM=galicea
KEYCLOAK_CLIENT_ID=paperless
KEYCLOAK_CLIENT_SECRET=<sekret klienta>
