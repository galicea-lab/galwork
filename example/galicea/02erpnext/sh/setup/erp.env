# Wspólne parametry instalacji ERPNext (wczytywane przez wszystkie skrypty setup).
# NIE wpisuj tu haseł - skrypty pytają o nie interaktywnie.

INST_ROOT="/erp"                         # katalog główny instalacji
BENCH_NAME="erpnext-bench"               # nazwa katalogu bench
INST="${INST_ROOT}/${BENCH_NAME}"        # pełna ścieżka bench
SITE="erp.example.org"                   # nazwa witryny = domena (FQDN) w nginx
FRAPPE_USER="$(id -un)"                  # użytkownik systemowy, z którego działa bench

# Python: Frappe/ERPNext v16 wymagają Pythona >=3.14,<3.15
PY_VERSION="3.14.2"
PYTHON314="${HOME}/.pyenv/versions/${PY_VERSION}/bin/python3"
# przy instalacji przez uv:  PYTHON314="$(uv python find 3.14)"

NODE_VERSION="24"
BRANCH="version-16"                      # gałąź frappe / erpnext / hrms

# Aplikacje Galicea
GIT_GALICEA="https://code.galicea.org/labc"
EDUCATION_URL="${GIT_GALICEA}/erpnext-education.git"     # fork frappe/education (lustro: github.com/galicea-lab/education)
EDUCATION_BRANCH="develop"
ERPNEXT_POLAND_URL="${GIT_GALICEA}/erpnext_poland.git"   # lustro: github.com/galicea-lab/erpnext_poland
ERPNEXT_POLAND_BRANCH="main"
ADMISSIONS_URL="${GIT_GALICEA}/admissions_poland.git"
ADMISSIONS_BRANCH="main"
