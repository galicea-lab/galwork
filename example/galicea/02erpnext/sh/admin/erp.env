# Parametry instancji dla skryptów administracyjnych. Bez haseł!
INST_ROOT="/erp"
BENCH_NAME="erpnext-bench"
INST="${INST_ROOT}/${BENCH_NAME}"
SITE="erp.example.org"            # domyślna witryna; większość skryptów przyjmuje też -s <witryna>
BACKUP_DIR="${INST_ROOT}/backup"  # kopie zbiorcze (kopia.sh)
BACKUP_KEEP_DAYS=30               # ile dni trzymać kopie w BACKUP_DIR
NODE_VERSION="24"
